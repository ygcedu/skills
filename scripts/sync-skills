#!/bin/sh
set -eu

cd "$(dirname "$0")/.."
config=third-party-skills.conf
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT HUP INT TERM
get() { git config --file "$config" --get "skill.$name.$1"; }
git config --file "$config" --name-only --get-regexp '^skill\.[a-z0-9-]+\.repository$' > "$tmp/keys"

while read -r key; do
  name=${key#skill.}; name=${name%.repository}
  commit=$(get commit || :); tag=$(get tag || :); source=$(get source)
  if [ -n "$commit" ] && [ -z "$tag" ]; then
    case "$commit" in *[!0-9a-f]*) exit 1 ;; esac
    [ "${#commit}" -eq 40 ] || exit 1
    ref=$commit
  elif [ -n "$tag" ] && [ -z "$commit" ]; then
    ref="refs/tags/$tag"
    git check-ref-format "$ref"
  else
    echo "$name: commit 和 tag 必须且只能填写一个。" >&2; exit 1
  fi
  case "$source" in ''|/*|*..*) exit 1 ;; esac
  repo="$tmp/$name"; destination=$(get destination)
  case "$destination" in skills/*) ;; *) exit 1 ;; esac
  case "$destination" in *..*|skills/) exit 1 ;; esac
  [ ! -L "$destination" ] || exit 1
  echo "$name: 同步 $ref"
  git init -q "$repo"
  git -C "$repo" fetch -q --depth=1 --no-tags -- "$(get repository)" "$ref"
  actual=$(git -C "$repo" rev-parse 'FETCH_HEAD^{commit}')
  [ -z "$commit" ] || [ "$actual" = "$commit" ] || exit 1
  echo "$name: commit $actual"
  git -C "$repo" checkout -q FETCH_HEAD -- "$source"
  [ -f "$repo/$source/SKILL.md" ] || exit 1
  mkdir -p "$(dirname "$destination")"
  cp -R "$repo/$source" "$tmp/$name-new"
  if [ -e "$destination" ]; then
    mv "$destination" "$tmp/$name-old"
  fi
  mv "$tmp/$name-new" "$destination"
done < "$tmp/keys"
